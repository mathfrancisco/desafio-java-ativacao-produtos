{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /FAIL-.*/)]" }]
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid_product" }
      }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /UNSTABLE-.*/)]" }]
      },
      "response": { "status": 503 }
    },
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "url": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /SLOW-.*/)]" }]
      },
      "response": { "status": 200, "fixedDelayMilliseconds": 10000 }
    },
    {
      "priority": 10,
      "request": { "method": "POST", "url": "/provider/v1/activate" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "activationId": "{{randomValue type='UUID'}}", "status": "ACTIVE" }
      }
    }
  ]
}
